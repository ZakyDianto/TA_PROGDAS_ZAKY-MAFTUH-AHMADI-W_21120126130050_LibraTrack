<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.libratrack.PeminjamanController"
            prefWidth="1100" prefHeight="700"
            stylesheets="@style.css"
            styleClass="root">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="240" spacing="25" styleClass="sidebar">
            <padding>
                <Insets top="30" right="20" bottom="25" left="20"/>
            </padding>

            <VBox spacing="5">
                <Label text="LibraTrack" styleClass="brand"/>
                <Label text="LIBRARY MANAGEMENT"
                       styleClass="brand-subtitle"/>
            </VBox>

            <VBox spacing="12">
                <Label text="MAIN MENU" styleClass="menu-heading"/>

                <Label text="▣   Dashboard"
                       maxWidth="Infinity"
                       onMouseClicked="#keDashboard"
                       styleClass="menu-item"/>

                <Label text="▤   Data Buku"
                       maxWidth="Infinity"
                       onMouseClicked="#keDataBuku"
                       styleClass="menu-item"/>

                <Label text="♙   Data Anggota"
                       maxWidth="Infinity"
                       onMouseClicked="#keDataAnggota"
                       styleClass="menu-item"/>

                <Label text="⇄   Peminjaman &amp; Pengembalian"
                       maxWidth="Infinity"
                       onMouseClicked="#kePeminjaman"
                       styleClass="menu-item-active"/>

                <Label text="◷   Riwayat"
                       maxWidth="Infinity"
                       onMouseClicked="#keRiwayat"
                       styleClass="menu-item"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="LibraTrack v1.0"
                   styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="25" styleClass="content">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <VBox spacing="5">
                <Label text="Peminjaman &amp; Pengembalian"
                       styleClass="page-title"/>

                <Label text="Catat peminjaman buku baru dan proses pengembalian beserta denda otomatis"
                       styleClass="page-subtitle"/>
            </VBox>

            <!-- SEARCH AND ADD -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="txtCariPeminjaman"
                           promptText="Cari nama peminjam atau judul buku..."
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>

                <Button text="+ Peminjaman Baru"
                        styleClass="gold-button"
                        onAction="#tambahPeminjaman"/>
            </HBox>

            <!-- LOAN TABLE -->
            <VBox styleClass="table-container" spacing="15" VBox.vgrow="ALWAYS">
                <Label text="Daftar Peminjaman Aktif"
                       styleClass="section-title"/>

                <TableView fx:id="tablePeminjaman" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn text="No." prefWidth="45" maxWidth="55"/>
                        <TableColumn text="Peminjam" prefWidth="200"/>
                        <TableColumn text="Judul Buku" prefWidth="210"/>
                        <TableColumn text="Tgl Pinjam" prefWidth="115"/>
                        <TableColumn text="Batas Pinjam" prefWidth="105"/>
                        <TableColumn text="Aksi" prefWidth="135"/>
                    </columns>
                </TableView>
            </VBox>

            <Label text="Klik tombol Kembalikan pada baris untuk menghitung denda otomatis"
                   styleClass="system-description"/>

        </VBox>
    </center>

</BorderPane>