<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.libratrack.BukuController"
            prefWidth="1100" prefHeight="700"
            stylesheets="@style.css"
            styleClass="root">

    <!-- SIDEBAR (Sama persis dengan Dashboard) -->
    <left>
        <VBox prefWidth="240" spacing="25" styleClass="sidebar">
            <padding>
                <Insets top="30" right="20" bottom="25" left="20"/>
            </padding>

            <VBox spacing="5">
                <Label text="LibraTrack" styleClass="brand"/>
                <Label text="LIBRARY MANAGEMENT"
                       styleClass="brand-subtitle"/>
            </VBox>

            <VBox spacing="12">
                <Label text="MAIN MENU" styleClass="menu-heading"/>

                <Label text="▣   Dashboard"
                       maxWidth="Infinity"
                       onMouseClicked="#keDashboard"
                       styleClass="menu-item"/>

                <Label text="▤   Data Buku"
                       maxWidth="Infinity"
                       onMouseClicked="#keDataBuku"
                       styleClass="menu-item-active"/>

                <Label text="♙   Data Anggota"
                       maxWidth="Infinity"
                       onMouseClicked="#keDataAnggota"
                       styleClass="menu-item"/>

                <Label text="⇄   Peminjaman &amp; Pengembalian"
                       maxWidth="Infinity"
                       onMouseClicked="#kePeminjaman"
                       styleClass="menu-item"/>

                <Label text="◷   Riwayat"
                       maxWidth="Infinity"
                       onMouseClicked="#keRiwayat"
                       styleClass="menu-item"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="LibraTrack v1.0"
                   styleClass="sidebar-footer"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="25" styleClass="content">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <VBox spacing="5">
                <Label text="Data Buku"
                       styleClass="page-title"/>

                <Label text="Kelola koleksi buku perpustakaan"
                       styleClass="page-subtitle"/>
            </VBox>

            <!-- SEARCH AND ADD -->
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <TextField fx:id="txtCariBuku"
                                promptText="Cari judul atau penulis buku..."
                                styleClass="search-field"
                                HBox.hgrow="ALWAYS"/>
                        <Button text="+ Tambah Buku"
                                styleClass="gold-button"
                                onAction="#tambahBuku"/>
                    </HBox>

            <!-- BOOK TABLE -->
            <VBox styleClass="table-container" spacing="15" VBox.vgrow="ALWAYS">
                <Label text="Daftar Koleksi Buku"
                       styleClass="section-title"/>

                <TableView fx:id="tableBuku" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn text="No." prefWidth="55" maxWidth="65"/>
                        <TableColumn text="Judul Buku" prefWidth="230"/>
                        <TableColumn text="Penulis" prefWidth="170"/>
                        <TableColumn text="Kategori" prefWidth="130"/>
                        <TableColumn text="Stok" prefWidth="75" maxWidth="90"/>
                        <TableColumn text="Aksi" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <Label text="Menampilkan data koleksi buku LibraTrack"
                   styleClass="system-description"/>

        </VBox>
    </center>

</BorderPane>